{
  "expo": {
    "name": "ToolKit",
    "slug": "ToolKit",
    "scheme": "toolkit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/favicon1.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141416",
        "foregroundImage": "./assets/favicon1.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon1.png"
    },
    "plugins": [
      "expo-sharing",
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ]
  }
}
